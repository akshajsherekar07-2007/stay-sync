# ==============================================================
# StaySync Backend — Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME=StaySync
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Database (Supabase PostgreSQL) ───────────────────────────
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-publishable-key
DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/database
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery (Phase 2.2) ──────────────────────────────────────
# These use REDIS_URL as broker automatically.
# Result backend uses Redis DB 1 (derived from REDIS_URL).
CELERY_RESULT_EXPIRES_SECONDS=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ── Celery Beat (Phase 2.2.3) ────────────────────────────────
# How often the bulk hold-expiry scan fires (seconds, multiple of 60).
CELERY_BEAT_EXPIRE_SCAN_INTERVAL_SECONDS=60
# How often the expiring-soon notification scan fires (seconds, multiple of 60).
CELERY_BEAT_EXPIRING_SOON_INTERVAL_SECONDS=900

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email (Phase 2) ─────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM_ADDRESS=noreply@staysync.app

# ── Google Maps (Phase 1.5) ──────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
